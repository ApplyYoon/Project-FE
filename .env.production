# 배포용 환경변수입니다. `pnpm build`(배포 빌드)일 때만 읽습니다. `pnpm dev` 는 .env.development 를 읽습니다.
# 각 값이 무엇인지는 .env.example 에 자세히 적혀 있습니다.
#
# ⚠️ 이 파일은 GitHub 에 올라갑니다. 서버 주소처럼 공개돼도 되는 값만 넣습니다. API 키·비밀번호는 절대 넣지 마세요.
#    Vercel 의 Environment Variables 에 같은 이름이 있으면 그쪽 값이 이깁니다.

# 배포한 BE(Render) 서버 주소
VITE_API_BASE_URL=https://project-be-mxxc.onrender.com/api/v1

# BE 가 배포됐으니 테스트 로그인 버튼을 숨깁니다. (구글로 시작하기만 보입니다)
VITE_TEST_LOGIN=false
